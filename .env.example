# Server-side only (Vercel project settings → Environment Variables). Never commit real keys.
OPENROUTER_API_KEY=
# Optional: override the models. Defaults are set in server/agent-handler.ts.
OPENROUTER_MODEL=openai/gpt-6.1-terra
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash-1017
# Optional: the public URL, sent to OpenRouter as the referer.
PUBLIC_SITE_URL=

# Google Calendar connector (browser). A public OAuth *Web* client ID, not a secret.
# Leave empty to hide the calendar features.
VITE_GOOGLE_CLIENT_ID=

# Accounts (Supabase). Both are public values; the browser and the server use them.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Show "Continue with Google" once Google is set up in Supabase → Authentication → Providers.
VITE_GOOGLE_SIGNIN=
# Turn the free-plan AI limit (5 requests) on at launch.
VITE_AI_FREE_LIMIT=

# Testing shortcut: "Send me a code" lets people straight in (no email check, no cloud account). Remove to turn real sign-in back on.
VITE_AUTH_MODE=
