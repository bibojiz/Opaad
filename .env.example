# Server-side only (Vercel project settings → Environment Variables). Never commit real keys.
OPENROUTER_API_KEY=
# Optional: override the models. Defaults are set in server/agent-handler.ts.
OPENROUTER_MODEL=openai/gpt-6.1-terra
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash-1017
# Optional: the public URL, sent to OpenRouter as the referer.
PUBLIC_SITE_URL=
